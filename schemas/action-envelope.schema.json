{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi-loop-engineering.local/schemas/action-envelope.schema.json",
  "title": "PI Immutable Release Action Envelope",
  "oneOf": [{ "$ref": "#/$defs/commit" }, { "$ref": "#/$defs/external" }, { "$ref": "#/$defs/physical" }],
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "sha": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
    "releaseAction": { "enum": ["commit", "push", "pr", "tag", "publish", "deploy-sim", "run-hil", "deploy-robot", "run-real-robot"] },
    "authorization": { "type": "object", "additionalProperties": false, "required": ["authorization_id", "action", "target", "environment_node", "authorized_by", "authorized_at", "expires_at", "digest"], "properties": { "authorization_id": { "type": "string", "minLength": 1 }, "action": { "$ref": "#/$defs/releaseAction" }, "target": { "type": "string", "minLength": 1 }, "environment_node": { "type": ["string", "null"], "enum": ["SOURCE_STATIC", "UNIT_COMPONENT", "REPLAY", "SIMULATION", "SIL", "HIL", "BENCH", "CLOSED_COURSE", "REAL_VEHICLE_ROBOT", null] }, "authorized_by": { "type": "string", "minLength": 1 }, "authorized_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T" }, "expires_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T" }, "digest": { "$ref": "#/$defs/digest" } } },
    "commit": { "type": "object", "additionalProperties": false, "required": ["schema_version", "operation_id", "release_id", "handoff_digest", "target", "source_head_sha", "reviewed_tree_digest", "authorization", "metadata_digest", "action", "expected_parent_sha", "branch"], "properties": { "schema_version": { "const": 1 }, "operation_id": { "type": "string", "minLength": 1 }, "release_id": { "type": "string", "minLength": 1 }, "handoff_digest": { "$ref": "#/$defs/digest" }, "target": { "type": "string", "minLength": 1 }, "source_head_sha": { "$ref": "#/$defs/sha" }, "reviewed_tree_digest": { "$ref": "#/$defs/digest" }, "authorization": { "$ref": "#/$defs/authorization" }, "metadata_digest": { "$ref": "#/$defs/digest" }, "action": { "const": "commit" }, "expected_parent_sha": { "$ref": "#/$defs/sha" }, "branch": { "type": "string", "minLength": 1 } } },
    "external": { "type": "object", "additionalProperties": false, "required": ["schema_version", "operation_id", "release_id", "handoff_digest", "target", "source_head_sha", "reviewed_tree_digest", "authorization", "metadata_digest", "action", "release_commit_sha"], "properties": { "schema_version": { "const": 1 }, "operation_id": { "type": "string", "minLength": 1 }, "release_id": { "type": "string", "minLength": 1 }, "handoff_digest": { "$ref": "#/$defs/digest" }, "target": { "type": "string", "minLength": 1 }, "source_head_sha": { "$ref": "#/$defs/sha" }, "reviewed_tree_digest": { "$ref": "#/$defs/digest" }, "authorization": { "$ref": "#/$defs/authorization" }, "metadata_digest": { "$ref": "#/$defs/digest" }, "action": { "enum": ["push", "pr", "tag", "publish", "deploy-sim"] }, "release_commit_sha": { "$ref": "#/$defs/sha" } } },
    "physical": { "type": "object", "additionalProperties": false, "required": ["schema_version", "operation_id", "release_id", "handoff_digest", "target", "source_head_sha", "reviewed_tree_digest", "authorization", "metadata_digest", "action", "release_commit_sha", "environment_node"], "properties": { "schema_version": { "const": 1 }, "operation_id": { "type": "string", "minLength": 1 }, "release_id": { "type": "string", "minLength": 1 }, "handoff_digest": { "$ref": "#/$defs/digest" }, "target": { "type": "string", "minLength": 1 }, "source_head_sha": { "$ref": "#/$defs/sha" }, "reviewed_tree_digest": { "$ref": "#/$defs/digest" }, "authorization": { "$ref": "#/$defs/authorization" }, "metadata_digest": { "$ref": "#/$defs/digest" }, "action": { "enum": ["run-hil", "deploy-robot", "run-real-robot"] }, "release_commit_sha": { "$ref": "#/$defs/sha" }, "environment_node": { "enum": ["HIL", "BENCH", "CLOSED_COURSE", "REAL_VEHICLE_ROBOT"] } } }
  }
}
