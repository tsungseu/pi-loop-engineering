{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pi-loop-engineering.local/schemas/event.schema.json",
  "title": "PI Loop Ledger Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sequence", "event_id", "loop_id", "type", "actor_role", "timestamp", "previous_hash", "payload", "hash"],
  "properties": {
    "schema_version": { "const": 1 },
    "sequence": { "type": "integer", "minimum": 1 },
    "event_id": { "type": "string", "minLength": 1 },
    "loop_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$" },
    "type": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
    "actor_role": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T" },
    "previous_hash": { "$ref": "#/$defs/digest" },
    "payload": { "type": "object", "additionalProperties": false, "required": ["kind", "data_digest"], "properties": { "kind": { "type": "string", "minLength": 1 }, "data_digest": { "$ref": "#/$defs/digest" } } },
    "hash": { "$ref": "#/$defs/digest" }
  },
  "$defs": { "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
}
