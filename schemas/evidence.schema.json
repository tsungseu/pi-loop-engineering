{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pai-loop-engineering.local/schemas/evidence.schema.json",
  "title": "PAI Bound Execution Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_id", "loop_id", "work_item_id", "attempt", "actor_role", "h1_digest", "wave_input_digest", "output_tree_digest", "argv", "cwd", "started_at", "ended_at", "exit_code", "environment_digest", "tool_versions", "stdout_path", "stdout_digest", "stderr_path", "stderr_digest", "artifact_manifest_digest", "result"],
  "properties": {
    "schema_version": { "const": 1 }, "evidence_id": { "type": "string", "minLength": 1 }, "loop_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,95}$" }, "work_item_id": { "type": "string", "minLength": 1 }, "attempt": { "type": "integer", "minimum": 1 }, "actor_role": { "type": "string", "minLength": 1 },
    "h1_digest": { "$ref": "#/$defs/digest" }, "wave_input_digest": { "$ref": "#/$defs/digest" }, "output_tree_digest": { "$ref": "#/$defs/digest" },
    "argv": { "type": "array", "items": { "type": "string" } }, "cwd": { "type": "string", "minLength": 1 }, "started_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T" }, "ended_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T" }, "exit_code": { "type": ["integer", "null"] },
    "environment_digest": { "$ref": "#/$defs/digest" }, "tool_versions": { "type": "object", "propertyNames": { "type": "string", "minLength": 1 }, "additionalProperties": { "type": "string" } },
    "stdout_path": { "type": "string", "minLength": 1 }, "stdout_digest": { "$ref": "#/$defs/digest" }, "stderr_path": { "type": "string", "minLength": 1 }, "stderr_digest": { "$ref": "#/$defs/digest" }, "artifact_manifest_digest": { "$ref": "#/$defs/digest" }, "result": { "enum": ["PASS", "FAIL", "PRE_EXISTING", "NOT_RUN"] }
  },
  "$defs": { "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
}
