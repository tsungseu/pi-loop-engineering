# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
.venv/
venv/
env/

# --- Superworkflows runtime state ---
# Durable run state and machine-captured evidence are per-machine, never committed.
.ai/
# CodeGraph index is generated tooling state, excluded from freshness/runtime hashes.
.codegraph/

# --- Tooling / tests ---
.coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
node_modules/
.test-dist/
*.tmp-*

# --- Local-only planning / design notes (superpowers SDD artifacts) ---
# These are per-developer working notes, not part of the shipped plugin.
docs/
.superpowers/
findings.md
progress.md
task_plan.md

# --- Editors / IDE ---
.vscode/
.idea/
*.swp
*.swo

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini
